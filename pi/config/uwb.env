# Cấu hình chạy trên Pi. Đọc bởi scripts/*.sh và systemd (EnvironmentFile).
# Mỗi dòng KEY=value, chú thích viết riêng một dòng (systemd không hiểu chú thích cuối dòng).
# sync.sh KHÔNG ghi đè file này khi đã có trên Pi, nên sửa trực tiếp trên Pi.

# IP máy chạy QGC (NUC). QGC tự nhận kết nối UDP trên cổng 14550.
QGC_IP=192.168.0.2
QGC_PORT=14550

# Cổng nối xuống TELEM2/SERIAL2 của FC (UART5 của Pi) và baud, phải khớp SERIAL2_BAUD=921.
FC_PORT=/dev/ttyAMA5
FC_BAUD=921600

# Cổng UDP nội bộ mà fc_router mở cho uwb_bridge.
LOCAL_UDP=14540

# BẮT BUỘC: hướng la bàn của cạnh A1->A2 (độ, 0=Bắc, 90=Đông). Để trống thì run_uwb.sh từ chối chạy.
# Đo bằng: scripts/measure_heading.sh (drone nằm yên, mũi hướng từ A1 sang A2).
# Sai hướng nhiều thì PosHold vẽ vòng hoặc bay mất kiểm soát.
HEADING=

# EKF origin: vĩ độ,kinh độ,độ cao(m) của chỗ bay. ArduPilot dùng để tính độ lệch từ của la bàn.
# Giá trị dưới đây là TẠM (khoảng Hà Nội), hãy thay bằng tọa độ thật lấy từ điện thoại.
ORIGIN=21.0285,105.8542,10

# Độ cao của tag so với sàn khi drone nằm trên mặt đất (m).
TAG_Z=0.10

# Tần số gửi vị trí (Hz, tối đa 50). ArduPilot EKF3 bỏ mẫu cách nhau dưới 20 ms nên để 30.
RATE=30

# 1 = chỉ dùng bản đồ anchor do tag tự calib trong lần bật nguồn này (anchor được treo lại mỗi lần bay).
# Chưa calib xong thì không gửi vị trí, FC báo VisOdom not healthy và không cho arm. 0 = dùng anchors.toml khi chưa calib.
REQUIRE_SURVEY=1
